@using System.Security.Claims
@using SolicitudIT_Isertec.Models
@model SolicitudIT_Isertec.Controllers.ChatVm

@{
    var currentUserId = 0;
    var claim = User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (!string.IsNullOrWhiteSpace(claim))
    {
        int.TryParse(claim, out currentUserId);
    }
}

<div class="page-head">
    <div>
        <p class="eyebrow">COMUNICACIÓN BT</p>
        <h1>Chat</h1>
        <p class="muted">
            Conversaciones privadas entre el solicitante y el técnico asignado.
        </p>
    </div>
</div>

<div class="chat-shell">

    <aside class="chat-list">

        <div class="chat-title">
            Solicitudes
        </div>

        @if (!Model.Requests.Any())
        {
            <div class="chat-empty">
                No tienes conversaciones disponibles.
            </div>
        }
        else
        {
            foreach (var solicitud in Model.Requests)
            {
                <a class="chat-item @(Model.SelectedId == solicitud.Id ? "active" : "")"
                   asp-action="Index"
                   asp-route-id="@solicitud.Id">

                    <strong>
                        @solicitud.Codigo
                    </strong>

                    <span>
                        @solicitud.Titulo
                    </span>

                </a>
            }
        }

    </aside>

    <section class="chat-main">

        @if (Model.SelectedId.HasValue)
        {
            var solicitudSeleccionada =
                Model.Requests.FirstOrDefault(
                    x => x.Id == Model.SelectedId.Value
                );

            if (solicitudSeleccionada != null)
            {
                <div class="chat-head">
                    <b>
                        @solicitudSeleccionada.Codigo
                    </b>

                    <span>
                        @solicitudSeleccionada.Titulo
                    </span>
                </div>

                <div id="messages"
                     class="messages"
                     data-current-user-id="@currentUserId">

                    @if (!Model.Messages.Any())
                    {
                        <div class="chat-empty">
                            No hay mensajes todavía.
                        </div>
                    }
                    else
                    {
                        foreach (var message in Model.Messages)
                        {
                            <div class="message @(message.RemitenteId == currentUserId ? "mine" : "")">

                                <b>
                                    @message.Remitente.Nombre
                                    @message.Remitente.Apellido
                                </b>

                                <small>
                                    @message.CreadoEn
                                        .ToLocalTime()
                                        .ToString("HH:mm")
                                </small>

                                @if (!string.IsNullOrWhiteSpace(message.Mensaje))
                                {
                                    <p>
                                        @message.Mensaje
                                    </p>
                                }

                                @if (message.Adjunto != null)
                                {
                                    <div class="message-attachment">
                                        <a asp-controller="Archivo"
                                           asp-action="Download"
                                           asp-route-id="@message.Adjunto.Id"
                                           target="_blank">

                                            📎 @message.Adjunto.NombreOriginal

                                        </a>
                                    </div>
                                }

                            </div>
                        }
                    }

                </div>

                <form asp-action="Send"
                      method="post"
                      enctype="multipart/form-data"
                      class="composer">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="solicitudId"
                           value="@Model.SelectedId" />

                    <input name="mensaje"
                           placeholder="Escribe un mensaje..."
                           autocomplete="off" />

                    <label class="attach"
                           title="Adjuntar archivo">

                        📎

                        <input name="file"
                               type="file"
                               hidden />

                    </label>

                    <button type="submit">
                        ➤
                    </button>

                </form>
            }
        }
        else
        {
            <div class="chat-no-selection">
                <h2>Selecciona una solicitud</h2>
                <p>
                    El chat se habilita cuando existe un técnico asignado.
                </p>
            </div>
        }

    </section>

</div>
