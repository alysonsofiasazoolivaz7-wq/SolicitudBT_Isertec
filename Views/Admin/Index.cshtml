@model AdminVm
<div class="page-head"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Administración</h1></div></div><div class="admin-sections"><section class="panel"><h2>Usuarios</h2><form asp-action="UserSave" method="post" class="grid3"><input name="nombre" placeholder="Nombre"><input name="apellido" placeholder="Apellido"><input name="usuario" placeholder="Usuario"><input name="email" placeholder="Correo"><input name="password" type="password" placeholder="Contraseña"><select name="rol"><option>usuario</option><option>tecnico</option><option>admin</option></select><button class="btn primary">Crear usuario</button></form><table><tbody>@foreach(var u in Model.Usuarios){<tr><td>@u.Nombre @u.Apellido</td><td>@u.Email</td><td>@u.Rol</td><td>@(u.Activo?"Activo":"Inactivo")</td></tr>}</tbody></table></section><section class="panel"><h2>Equipos</h2><form asp-action="EquipmentSave" method="post" class="grid3"><input name="codigo" placeholder="Código"><input name="tipo" placeholder="Tipo"><input name="marca" placeholder="Marca"><input name="modelo" placeholder="Modelo"><input name="numeroSerie" placeholder="Número de serie"><input name="ubicacion" placeholder="Ubicación"><select name="estado"><option>activo</option><option>mantenimiento</option><option>baja</option></select><button class="btn primary">Registrar equipo</button></form><table><tbody>@foreach(var e in Model.Equipos){<tr><td>@e.Codigo</td><td>@e.Tipo</td><td>@e.Marca @e.Modelo</td><td>@e.Usuario?.Nombre @e.Usuario?.Apellido</td><td>@e.Estado</td></tr>}</tbody></table></section></div>
