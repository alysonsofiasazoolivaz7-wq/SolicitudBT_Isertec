@model DashboardVm
<div class="hero"><div><p class="eyebrow">PANEL DE SOPORTE</p><h1>Hola, @User.Identity!.Name</h1><p>Gestiona solicitudes, comunicación y seguimiento desde un solo lugar.</p></div>@if(Model.Role=="usuario"){<a class="btn primary" asp-controller="Solicitudes" asp-action="Create">+ Nueva solicitud</a>}</div>
<div class="stats"><div><span>Total</span><strong>@Model.Total</strong></div><div><span>Pendientes</span><strong>@Model.Pendientes</strong></div><div><span>En proceso</span><strong>@Model.EnProceso</strong></div></div>
<div class="cards">
<a asp-controller="Solicitudes" asp-action="Index"><h3>Solicitudes</h3><p>Consulta y da seguimiento a tus tickets.</p></a>
@if(Model.Role == "usuario")
{
<a asp-controller="Notificaciones" asp-action="Index"><h3>Notificaciones</h3><p>Revisa respuestas del técnico y actualizaciones de tus solicitudes.</p></a>
}
</div>
