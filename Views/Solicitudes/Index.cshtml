@model List<Solicitud>
<div class="page-head"><div><p class="eyebrow">SOPORTE</p><h1>Solicitudes</h1></div>@if(User.IsInRole("usuario")){<a class="btn primary" asp-action="Create">+ Nueva solicitud</a>}</div>
<div class="table-card"><table><thead><tr><th>Código</th><th>Asunto</th><th>Categoría</th><th>Prioridad</th><th>Estado</th><th>Responsable BT</th><th>Fecha</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td><b>@s.Codigo</b></td><td>@s.Titulo</td><td>@s.Categoria?.Nombre</td><td><span class="tag priority @s.Prioridad">@s.Prioridad</span></td><td><span class="tag status @s.Estado">@s.Estado</span></td><td>@(s.Tecnico != null ? $"{s.Tecnico.Nombre} {s.Tecnico.Apellido}" : "Sin asignar")</td><td>@s.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><a asp-action="Details" asp-route-id="@s.Id">Ver</a></td></tr>}</tbody></table></div>
