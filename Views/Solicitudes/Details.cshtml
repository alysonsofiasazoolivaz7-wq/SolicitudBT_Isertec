@using System.Security.Claims
@model Solicitud

@{
    var currentUserId = 0;

    var claimUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (!string.IsNullOrWhiteSpace(claimUserId))
    {
        int.TryParse(claimUserId, out currentUserId);
    }

    var esAdmin = User.IsInRole("admin");
    var esTecnico = User.IsInRole("tecnico");
    var esUsuario = User.IsInRole("usuario");

    var puedeGestionar = esAdmin || esTecnico;
}

<div class="page-head">

    <div>
        <p class="eyebrow">@Model.Codigo</p>

        <h1>@Model.Titulo</h1>

        <p class="muted">
            @Model.Categoria?.Nombre
            ·
            @Model.Estado
            ·
            @Model.Prioridad
        </p>
    </div>


    @if (Model.Tecnico != null &&
         ((esUsuario && Model.UsuarioId == currentUserId) ||
          (esTecnico && Model.TecnicoId == currentUserId)))
    {
        var esTecnicoActual = esTecnico && Model.TecnicoId == currentUserId;
        var destinatario = esTecnicoActual
            ? Model.Usuario.Email
            : Model.Tecnico.Email;
        var nombreDestinatario = esTecnicoActual
            ? $"{Model.Usuario.Nombre} {Model.Usuario.Apellido}"
            : $"{Model.Tecnico.Nombre} {Model.Tecnico.Apellido}";
        var asunto = $"Solicitud {Model.Codigo} - {Model.Titulo}";
        var cuerpo = esTecnicoActual
            ? $"Hola {nombreDestinatario},\n\nSoy el técnico asignado a la solicitud {Model.Codigo}: {Model.Titulo}.\n\nDescripción de la solicitud:\n{Model.Descripcion}\n\nQuedo atento para dar seguimiento.\n\nSaludos."
            : $"Hola {nombreDestinatario},\n\nQuisiera consultar sobre mi solicitud {Model.Codigo}: {Model.Titulo}.\n\nDescripción de la solicitud:\n{Model.Descripcion}\n\nSaludos.";
        var gmailUrl = "https://mail.google.com/mail/?view=cm&fs=1" +
                       "&to=" + Uri.EscapeDataString(destinatario) +
                       "&su=" + Uri.EscapeDataString(asunto) +
                       "&body=" + Uri.EscapeDataString(cuerpo);

        <a class="btn primary" href="@gmailUrl" target="_blank" rel="noopener noreferrer">
            ✉ @(esTecnicoActual ? "Contactar al usuario por Gmail" : "Hablar con el técnico por Gmail")
        </a>
    }

</div>


@if (TempData["Success"] != null)
{
    <div class="success">
        @TempData["Success"]
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="info">
        @TempData["Info"]
    </div>
}


<div class="detail-grid">

    <!-- ========================================================= -->
    <!-- INFORMACIÓN DE LA SOLICITUD -->
    <!-- ========================================================= -->

    <section class="panel">

        <h3>Detalle de la solicitud</h3>

        <p class="pre">
            @Model.Descripcion
        </p>


        <dl>

            <dt>Solicitante</dt>

            <dd>
                @Model.Usuario?.Nombre
                @Model.Usuario?.Apellido
            </dd>


            <dt>Equipo</dt>

            <dd>

                @if (Model.Equipo != null)
                {
                    @Model.Equipo.Codigo
                }
                else
                {
                    <span>Sin equipo especificado</span>
                }

            </dd>


            <dt>Modalidad</dt>

            <dd>

                @if (Model.ModalidadAtencion == ModalidadAtencion.presencial)
                {
                    <span>Presencial</span>
                }
                else
                {
                    <span>Remoto</span>
                }

            </dd>


            @if (Model.ModalidadAtencion == ModalidadAtencion.presencial)
            {
                <dt>Visita solicitada</dt>

                <dd>

                    @if (Model.FechaVisitaSolicitada.HasValue)
                    {
                        @Model.FechaVisitaSolicitada.Value.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span>Sin fecha</span>
                    }


                    @if (Model.HoraVisitaSolicitada.HasValue)
                    {
                        <span>
                            ·
                            @Model.HoraVisitaSolicitada.Value.ToString(@"hh\:mm")
                        </span>
                    }
                    else
                    {
                        <span>· Sin hora</span>
                    }

                </dd>
            }
            else
            {
                <dt>Visita solicitada</dt>

                <dd>
                    No aplica: atención remota
                </dd>
            }


            <dt>Programación BT</dt>

            <dd>

                @if (Model.FechaProgramada.HasValue)
                {
                    @Model.FechaProgramada.Value.ToString("dd/MM/yyyy")
                }
                else
                {
                    <span>Sin fecha</span>
                }


                @if (Model.HoraInicioProgramada.HasValue)
                {
                    <span>
                        ·
                        @Model.HoraInicioProgramada.Value.ToString(@"hh\:mm")
                    </span>
                }
                else
                {
                    <span>· Sin hora de inicio</span>
                }


                @if (Model.HoraFinProgramada.HasValue)
                {
                    <span>
                        -
                        @Model.HoraFinProgramada.Value.ToString(@"hh\:mm")
                    </span>
                }

            </dd>


            <dt>Técnico solicitado</dt>

            <dd>

                @if (Model.TecnicoSolicitado != null)
                {
                    @Model.TecnicoSolicitado.Nombre
                    @Model.TecnicoSolicitado.Apellido
                }
                else
                {
                    <span>Que BT decida</span>
                }

            </dd>


            <dt>Técnico asignado</dt>

            <dd>

                @if (Model.Tecnico != null)
                {
                    @Model.Tecnico.Nombre
                    @Model.Tecnico.Apellido
                }
                else
                {
                    <span>Sin asignar</span>
                }

            </dd>


            <dt>Puede continuar trabajando</dt>

            <dd>

                @if (Model.PuedeContinuarTrabajando)
                {
                    <span>Sí</span>
                }
                else
                {
                    <span>No</span>
                }

            </dd>

        </dl>


        <!-- ===================================================== -->
        <!-- ARCHIVOS -->
        <!-- ===================================================== -->
        @if (Model.Adjuntos != null && Model.Adjuntos.Any())
        {
            <h3>Archivos adjuntos</h3>

            <div class="files">

                @foreach (var archivo in Model.Adjuntos)
                {
                    <a asp-controller="Archivo"
                       asp-action="Download"
                       asp-route-id="@archivo.Id">

                        📎 @archivo.NombreOriginal

                    </a>
                }

            </div>
        }

    </section>




</div>


<!-- ============================================================= -->
<!-- GESTIÓN BT -->
<!-- ============================================================= -->
@if (puedeGestionar)
{
    <section class="panel admin-form">

        <h3>Gestión BT</h3>


        <form asp-action="Update"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />


            <div class="grid3">


                <!-- ================================================= -->
                <!-- TÉCNICO -->
                <!-- ================================================= -->
                @if (esAdmin)
                {
                    <div>

                        <label>
                            Técnico asignado
                        </label>

                        <select name="tecnicoId">

                            <option value="">
                                Sin cambio
                            </option>


                            @foreach (var tecnico in (IEnumerable<Usuario>)ViewBag.Techs)
                            {
                                if (tecnico.Id == Model.TecnicoId)
                                {
                                    <option value="@tecnico.Id"
                                            selected>

                                        @tecnico.Nombre
                                        @tecnico.Apellido

                                    </option>
                                }
                                else
                                {
                                    <option value="@tecnico.Id">

                                        @tecnico.Nombre
                                        @tecnico.Apellido

                                    </option>
                                }
                            }

                        </select>

                    </div>
                }
                else
                {
                    <div>

                        <label>
                            Técnico asignado
                        </label>

                        <div class="input-like">

                            @if (Model.Tecnico != null)
                            {
                                @Model.Tecnico.Nombre
                                @Model.Tecnico.Apellido
                            }
                            else
                            {
                                <span>
                                    Sin asignar
                                </span>
                            }

                        </div>

                    </div>
                }


                <!-- ================================================= -->
                <!-- ESTADO -->
                <!-- ================================================= -->

                <div>

                    <label>
                        Estado
                    </label>

                    <select name="estado">

                        @foreach (var estado in Enum.GetValues<EstadoSolicitud>())
                        {
                            if (estado == Model.Estado)
                            {
                                <option value="@estado"
                                        selected>

                                    @estado

                                </option>
                            }
                            else
                            {
                                <option value="@estado">

                                    @estado

                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- ================================================= -->
                <!-- FECHA -->
                <!-- ================================================= -->

                <div>

                    <label>
                        Fecha programada
                    </label>

                    <input type="date"
                           name="fecha"
                           value="@(
                           Model.FechaProgramada.HasValue
                               ? Model.FechaProgramada.Value.ToString("yyyy-MM-dd")
                                                   : ""
                                           )" />

                </div>


                <!-- ================================================= -->
                <!-- INICIO -->
                <!-- ================================================= -->

                <div>

                    <label>
                        Inicio
                    </label>

                    <input type="time"
                           name="inicio"
                           value="@(
                           Model.HoraInicioProgramada.HasValue
                               ? Model.HoraInicioProgramada.Value.ToString(@"hh\:mm")
                                                   : ""
                                           )" />

                </div>


                <!-- ================================================= -->
                <!-- FIN -->
                <!-- ================================================= -->

                <div>

                    <label>
                        Fin
                    </label>

                    <input type="time"
                           name="fin"
                           value="@(
                           Model.HoraFinProgramada.HasValue
                               ? Model.HoraFinProgramada.Value.ToString(@"hh\:mm")
                                                   : ""
                                           )" />

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- SOLUCIÓN -->
            <!-- ===================================================== -->

            <label>
                Solución
            </label>

            <textarea name="solucion"
                      rows="5">@Model.Solucion</textarea>


            <!-- ===================================================== -->
            <!-- COMENTARIO -->
            <!-- ===================================================== -->

            <label>
                Comentario
            </label>

            <textarea name="comentario"
                      rows="4"
                      placeholder="Agrega información sobre el trabajo realizado..."></textarea>


            <button type="submit"
                    class="btn primary">

                Guardar cambios

            </button>

        </form>


        <!-- ===================================================== -->
        <!-- ACEPTAR SOLICITUD -->
        <!-- ===================================================== -->
        @if (!Model.TecnicoId.HasValue && esTecnico)
        {
            <form asp-action="Take"
                  method="post"
                  class="inline">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn primary">

                    Aceptar solicitud

                </button>

            </form>
        }


        <!-- ===================================================== -->
        <!-- SOLICITUD YA ASIGNADA -->
        <!-- ===================================================== -->
        @if (Model.TecnicoId.HasValue)
        {
            <div class="input-like">

                Solicitud asignada a:

                <strong>
                    @Model.Tecnico?.Nombre
                    @Model.Tecnico?.Apellido
                </strong>

            </div>
        }

    </section>
}