@inject SolicitudIT_Isertec.Services.NotificationService Notifier

@{
var authenticated =
User.Identity?.IsAuthenticated == true;

var userId =
    authenticated
        ? int.Parse(
            User.FindFirst(
                System.Security.Claims.ClaimTypes.NameIdentifier
            )!.Value
        )
        : 0;

var role =
    User.FindFirst(
        System.Security.Claims.ClaimTypes.Role
    )?.Value;

var isAdminPanel =
    authenticated &&
    role == "admin" &&
    string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);

var unread =
    authenticated && role == "usuario"
        ? await Notifier.UnreadAsync(userId)
        : 0;

var unreadSolicitudes =
    authenticated && (role == "tecnico" || role == "admin")
        ? await Notifier.UnreadSolicitudesAsync(userId)
        : 0;

}

<!doctype html>

<html lang="es">

<head>

<meta charset="utf-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1">

<title>
    Soporte BT · Isertec
</title>

<link rel="stylesheet"
      href="~/css/app.css">


</head>

<body>

@if (authenticated)
{ <aside class="sidebar">

    <div class="brand">

        <img src="~/img/logo-bt-white.png">

        <span>
            BUSINESS
            <br>
            TECHNOLOGY
        </span>

    </div>


    <nav>

        @if (isAdminPanel)
        {
            <a asp-controller="Home" asp-action="Index">
                ←
                <span>Volver al inicio</span>
            </a>

            <div class="section">ADMINISTRACIÓN</div>

            <a href="#usuarios">
                👤
                <span>Usuarios</span>
            </a>

            <a href="#equipos">
                ▣
                <span>Equipos</span>
            </a>

            <a href="#reportes">
                ▤
                <span>Reportes</span>
            </a>

            <a href="#mantenimiento">
                ⚙
                <span>Inventario de mantenimiento</span>
            </a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index">
                ⌂
                <span>Inicio</span>
            </a>

            <a asp-controller="Solicitudes" asp-action="Index">
                ▣
                <span>
                    Solicitudes
                    @if (unreadSolicitudes > 0)
                    {
                        <b class="request-alert" title="Nuevas solicitudes">
                            ♢ @unreadSolicitudes
                        </b>
                    }
                </span>
            </a>

            @if (role == "usuario")
            {
                <a asp-controller="Notificaciones" asp-action="Index">
                    ♢
                    <span>
                        Notificaciones
                        @if (unread > 0)
                        {
                            <b class="badge">@unread</b>
                        }
                    </span>
                </a>
            }

            @if (role == "tecnico" || role == "admin")
            {
                <a asp-controller="Calendario" asp-action="Index">
                    ▦
                    <span>Calendario</span>
                </a>
            }
        }

    </nav>


    <div class="side-bottom">

        <span>
            @User.Identity!.Name
        </span>

        <a asp-controller="Account"
           asp-action="Logout">

            Cerrar sesión

        </a>

    </div>

</aside>

}

<main class="@(authenticated ? "with-side" : "")">

<header class="top">

    <div>

        <strong>
            Soporte BT
        </strong>

        <span class="muted">
            · Isertec
        </span>

    </div>


    @if (authenticated)
    {
        <div class="top-actions">
            @if (role == "admin" && !isAdminPanel)
            {
                <a class="btn admin-tab" asp-controller="Admin" asp-action="Index">Administración</a>
            }
            <div class="user-pill">@role</div>
        </div>
    }

</header>


<div class="content">

    @RenderBody()

</div>

</main>

</body>

</html>
